/* preCICE fluid-side contract for the high-Re single-slice ANCF pilot.
 * The structure participant and its ANCF state are guarded by contract.json. */
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      preciceDict;
}

preciceConfig "precice-config.xml";
participant Fluid_0000;
modules (FSI);

FSI
{
    solverType incompressible;
    rho rho [1 -3 0 0 0 0 0] 1000;
    nu  nu  [0 2 -1 0 0 0 0] 1.13881e-6;
    namePointDisplacement pointDisplacement;
    nameCellDisplacement  cellDisplacement;
    nameForce Force;
}

interfaces
{
    Interface1
    {
        mesh Fluid-Mesh;
        patches (cylinder);
        locations faceCenters;
        readData (Displacement);
        writeData (Force);
    }
}
