FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

kInlet          0.1;

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.4415e-05;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.4415e-05;
    }

    outlet
    {
        type            zeroGradient;
    }

    upper
    {
        type            symmetryPlane;
    }

    lower
    {
        type            symmetryPlane;
    }

    cylinder
    {
        type            kqRWallFunction;
        value           uniform 1.4415e-05;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}

